# Wzór konfiguracji. Skopiuj do .env i uzupełnij; .env nie trafia do git.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=daiet
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=daiet
POSTGRES_PORT=5432

# --- Dane źródłowe (S-006) ---
# Opcjonalnie: katalog z lokalną kopią plików CSV USDA SR Legacy; puste = pobranie z USDA
USDA_SOURCE_DIR=

# --- Backend (S-007) ---
# Adres bazy dla backendu uruchamianego lokalnie (make run, testy); w docker compose backend dostaje
# własny adres z hostem "db", złożony z POSTGRES_* powyżej
DATABASE_URL=postgresql+psycopg://daiet:zmien-mnie@localhost:5432/daiet
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- Claude API (S-305) ---
ANTHROPIC_API_KEY=

# --- Bot Discord (S-405) ---
DISCORD_BOT_TOKEN=
